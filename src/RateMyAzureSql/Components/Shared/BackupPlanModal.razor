@inject SqlFlowService Flows
@inject IJSRuntime JS

<Modal Visible="_visible" Title="@Title" Wide="true" OnClose="Close">
    <ChildContent>
        @if (_databases.Count > 0)
        {
            <p class="small muted">
                Applies the chosen backup plan to @_databases.Count database@(_databases.Count == 1 ? "" : "s")
                @if (Groups.Count > 1) { <span>across @Groups.Count @Flow.HostPluralLabel() (one block per @Flow.HostLabel())</span> }
                else { <span>on '@_databases[0].ServerName'</span> }.
                Untick anything you do not want in the script.
            </p>
            <div class="fix-options">
                @foreach (var o in _options)
                {
                    <label class="check"><input type="checkbox" checked="@o.Enabled" @onchange="() => ToggleOption(o.Key)" /> @o.Label</label>
                }
            </div>

            <div class="script-tabs">
                <button class="tab @(_cli ? "" : "active")" @onclick="() => Switch(false)">PowerShell (Az.Sql)</button>
                <button class="tab @(_cli ? "active" : "")" @onclick="() => Switch(true)">Azure CLI</button>
            </div>
            <div class="script-wrap">
                <pre class="script">@Script</pre>
                <button class="btn btn-ghost btn-sm copy" @onclick="CopyAsync"><Icon Name="@(_copied ? "check" : "copy")" Size="14" /> @(_copied ? "Copied" : "Copy")</button>
            </div>

            @if (AllChanges.Count > 0)
            {
                <h4 class="mt">What changes</h4>
                <div class="table-wrap">
                    <table class="table inner">
                        <thead><tr><th>Database</th><th>Setting</th><th>From</th><th>To</th><th>Note</th></tr></thead>
                        <tbody>
                            @foreach (var (db, changes) in AllChanges)
                            {
                                foreach (var c in changes)
                                {
                                    <tr><td><b>@db.ServerName/@db.Name</b></td><td>@c.Setting</td><td class="muted">@c.From</td><td class="ok">@c.To</td><td class="muted small">@c.Note</td></tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <p class="ok small mt"><Icon Name="check" Size="14" /> Every selected database already matches the plan — the script would change nothing.</p>
            }
            <p class="small muted mt">The script is a starting point for a change you make deliberately, in your own session. RateMyAzureSQL itself never modifies Azure. Backup changes can add cost; see the cost notes on the Backups step.</p>
        }
    </ChildContent>
    <Footer>
        <span class="muted small">@(_cli ? "bash + Azure CLI 2.50 or later" : "Az.Sql 4.x or later")</span>
        <button class="btn btn-primary" @onclick="DownloadAsync"><Icon Name="download" Size="16" /> Download @(_cli ? ".sh" : ".ps1")</button>
    </Footer>
</Modal>

@code {
    [Parameter] public SqlFlowKind Flow { get; set; }

    private bool _visible;
    private bool _cli;
    private bool _copied;
    private List<SqlDatabaseInfo> _databases = [];
    private BackupPlan _plan = new();
    private List<BackupPlanService.PlanOption> _options = [];

    private SqlScanResult? Scan => Flows.State.For(Flow).Scan;
    private HashSet<string> Enabled => _options.Where(o => o.Enabled).Select(o => o.Key).ToHashSet();
    private List<(SqlDatabaseInfo Db, List<BackupPlanService.Change> Changes)> AllChanges =>
        _databases.Select(d => (Db: d, Changes: BackupPlanService.Describe(d, Scan?.Server(d.ServerId), _plan, Enabled))).Where(x => x.Changes.Count > 0).ToList();

    private List<IGrouping<string, SqlDatabaseInfo>> Groups => _databases.GroupBy(d => d.ServerId, StringComparer.OrdinalIgnoreCase).ToList();

    private string Title => _databases.Count == 1
        ? $"Backup script — {_databases[0].ServerName}/{_databases[0].Name}"
        : $"Backup script — {_databases.Count} databases";

    private string Script => string.Join("\n\n", Groups.Select(g =>
    {
        var dbs = g.OrderBy(d => d.Name, StringComparer.OrdinalIgnoreCase).ToList();
        var server = Scan?.Server(g.Key);
        return _cli ? BackupPlanService.GenerateCli(dbs, server, _plan, Enabled) : BackupPlanService.GeneratePowerShell(dbs, server, _plan, Enabled);
    }));

    public void Open(List<SqlDatabaseInfo> databases, BackupPlan plan)
    {
        _databases = databases;
        _plan = plan;
        _options = BackupPlanService.DefaultOptions(Flow);
        _copied = false;
        _visible = true;
        StateHasChanged();
    }

    private void Close() { _visible = false; _databases = []; }
    private void Switch(bool cli) { _cli = cli; _copied = false; }

    private void ToggleOption(string key)
    {
        _options = _options.Select(o => o.Key == key ? o with { Enabled = !o.Enabled } : o).ToList();
        _copied = false;
    }

    private async Task CopyAsync()
    {
        _copied = await JS.InvokeAsync<bool>("rms.copy", Script);
    }

    private async Task DownloadAsync()
    {
        var name = _databases.Count == 1 ? $"{_databases[0].ServerName}-{_databases[0].Name}" : $"{_databases[0].ServerName}-backups";
        var bytes = System.Text.Encoding.UTF8.GetBytes(Script);
        await JS.InvokeVoidAsync("rms.download", $"improve-backups-{name}.{(_cli ? "sh" : "ps1")}", Convert.ToBase64String(bytes), "text/plain");
    }
}
