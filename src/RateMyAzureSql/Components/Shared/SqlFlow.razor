@inject SqlFlowService Flows
@inject NavigationManager Nav

<div class="flow-header">
    <div>
        <h1><Icon Name="@(Flow == SqlFlowKind.SqlDatabase ? "database" : "server")" Size="26" /> @Flow.PluralLabel()</h1>
        <p class="muted">@Description</p>
    </div>
</div>

<StepBar Route="@Flow.Route()" Current="@CurrentStep" HasScan="@State.HasScan" HasBackupTargets="@HasBackupTargets" />

@switch (CurrentStep)
{
    case "grades":
        <GradesStep Flow="Flow" />
        break;
    case "backups":
        <BackupsStep Flow="Flow" />
        break;
    default:
        <ScopeStep Flow="Flow" OnScanCompleted="StateHasChanged" />
        break;
}

@code {
    [Parameter] public SqlFlowKind Flow { get; set; }
    [Parameter] public string? Step { get; set; }

    private FlowState State => Flows.State.For(Flow);

    private string CurrentStep
    {
        get
        {
            var requested = (Step ?? "scope").ToLowerInvariant();
            // Steps that need a scan fall back to scope when there is none (e.g. after a refresh).
            if (requested is "grades" or "backups" && !State.HasScan) return "scope";
            if (requested == "backups" && !HasBackupTargets) return "grades";
            return requested is "grades" or "backups" ? requested : "scope";
        }
    }

    private bool HasBackupTargets => State.Scan is { Ratings.Count: > 0 };

    private string Description => Flow == SqlFlowKind.SqlDatabase
        ? "Logical servers and the databases on them: server-level security settings, per-database backup policies, redundancy and replicas."
        : "SQL Managed Instances and their databases: instance-level security and backup storage settings, per-database retention policies and instance failover groups.";
}
